{
  "manifest_version": 3,
  "name": "Human Reader, powered by ElevenLabs",
  "version": "2.0.0",
  "description": "Read selected text aloud with your ElevenLabs voices. Simple voice search, playback controls and your own API key.",
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "host_permissions": [
    "https://api.elevenlabs.io/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "style.css",
        "images/play.svg",
        "images/stop.svg",
        "images/spinner.svg"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "permissions": [
    "storage",
    "contextMenus",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "minimum_chrome_version": "116",
  "commands": {
    "read-selection": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Read selected text with Human Reader"
    },
    "stop-reading": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Stop Human Reader"
    }
  }
}
